
# VARIABLES --------------------------------------------------------------------------------------
buildir = build
srcdir  = src

p_compile = -mz80 --asm=z80asm --std-c23 -S --reserve-regs-iy --sdcccall 1
p_tape    = -a 26298 -r 26298 -c 26297 -b

# RULES -----------------------------------------------------------------------------------------

# C compiler: sdcc (.c -> .asm) + _fix_sdcc_asm.ps1 (patch) + z88dk-z80asm (.asm -> .o)
# z80asm -o=$out writes directly to the target path, avoiding the double-extension problem
rule compile_c
  command = cmd /v:on /c "set O=$out && set A=!O:.o=.asm! && sdcc $p_compile -o !A! $in && powershell -NoProfile -File _fix_sdcc_asm.ps1 !A! && z80asm -o=$out !A!"
  description = cc: $out

# ASM assembler: z88dk-z80asm (.asm -> .o)
rule compile_asm
  command = z80asm -o=$out $in
  description = asm: $out

# Linker: z88dk-z80asm binary mode (.o -> .bin)
# ORG addresses are baked into crt0.asm sections; -m generates map file
rule link
  command = z80asm -b -m -o=$out $in
  description = link: $out

# Bin2Tap: concatenate HEAP+CRT (adjacent: 0x5B00..0x66B9 + 0x66BA..)
rule tap
  command = cmd /c "bin2tap $p_tape -o $out $in"
  description = tap: $out


# COMPILE ---------------------------------------------------------------------------------------

# src  (output: build/xxx.o)
build $buildir/crt0.o:       compile_asm $srcdir/crt0.asm
build $buildir/sp1_ex1.o:    compile_c   $srcdir/sp1_ex1.c
build $buildir/sp1_ex3.o:    compile_c   $srcdir/sp1_ex3.c
build $buildir/sp1_ex4.o:    compile_c   $srcdir/sp1_ex4.c
build $buildir/sp1_ex7.o:    compile_c   $srcdir/sp1_ex7.c

# src/sp1_evenrot  (output: build/xxx.o)
build $buildir/sp1lib.o:     compile_c   $srcdir/sp1_evenrot/sp1lib.c
